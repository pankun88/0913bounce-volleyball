{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      "firebase.safe-rollback.json",
      "firestore.safe-rollback.rules",
      ".firebaserc",
      "**/*.md",
      "package.json",
      "package-lock.json",
      "functions/**",
      "test/**",
      "artifacts/**",
      "0627경기결과/**",
      "**/.*",
      "**/node_modules/**",
      "**/*.mjs",
      "**/*.png",
      "**/*.command"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "hub": {
      "port": 4400
    },
    "logging": {
      "port": 4500
    },
    "ui": {
      "enabled": false
    }
  }
}
