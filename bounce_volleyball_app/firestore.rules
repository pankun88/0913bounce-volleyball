rules_version = '2';

// ⚠️ 로그인 기능이 없는 간단한 1회성 대회 운영 도구이기 때문에,
// 누구나 읽고 쓸 수 있도록 열어두었습니다 (대시보드는 누구나 볼 수 있어야 하므로).
// 관리자 페이지(admin.html) 주소는 외부에 공유하지 마세요.
// 더 강한 보안이 필요하면 Firebase Authentication을 추가해 이 규칙을 보완하세요.
service cloud.firestore {
  match /databases/{database}/documents {
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if true;

      match /{subcollection}/{docId} {
        allow read: if true;
        allow write: if true;
      }
    }
  }
}
