rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isMain(tournamentId) {
      return tournamentId == 'main';
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/tournaments/main/admins/$(request.auth.uid));
    }

    function tournament(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId));
    }

    function isNotMaintained(tournamentId) {
      return tournament(tournamentId).data.get('maintenance', {}).get('enabled', false) != true;
    }

    function accessConfig(tournamentId) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)/recorderAccess/config);
    }

    // This deliberately uses the canonical private config, rather than the
    // public challenge projection. Rotating or revoking the code invalidates
    // every older grant without a client-side migration.
    function hasCurrentRecorderGrant(tournamentId) {
      let root = tournament(tournamentId);
      let config = accessConfig(tournamentId);
      let grant = get(/databases/$(database)/documents/tournaments/$(tournamentId)/recorderGrants/$(request.auth.uid));
      return request.auth != null
        && root.data.get('maintenance', {}).get('enabled', false) != true
        && root.data.recorderFeatureEnabled == true
        && config.data.enabled == true
        && grant.data.uid == request.auth.uid
        && grant.data.version == config.data.version;
    }

    function assignment(tournamentId, matchKey) {
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)/courtAssignments/$(matchKey));
    }

    function queueFor(tournamentId, matchKey) {
      let currentAssignment = assignment(tournamentId, matchKey);
      return get(/databases/$(database)/documents/tournaments/$(tournamentId)/courtQueues/$(currentAssignment.data.courtId));
    }

    function auditAfter(tournamentId, transitionId) {
      return getAfter(/databases/$(database)/documents/tournaments/$(tournamentId)/auditEvents/$(transitionId));
    }

    function hasTransitionAudit(tournamentId, matchKey, eventType, reason) {
      let transitionId = request.resource.data.lastTransitionId;
      let event = auditAfter(tournamentId, transitionId);
      return transitionId is string
        && event.data.transitionId == transitionId
        && event.data.matchKey == matchKey
        && event.data.eventType == eventType
        && event.data.reason == reason
        && event.data.actor.uid == request.auth.uid
        && event.data.createdAt == request.time;
    }

    function auditHasExistingLock(tournamentId) {
      let event = auditAfter(tournamentId, request.resource.data.lastTransitionId);
      return event.data.before.lock.uid == resource.data.lock.uid
        && event.data.before.lock.token == resource.data.lock.token
        && event.data.before.lock.get('recorderName', '') == resource.data.lock.get('recorderName', '');
    }

    function auditHasNewLock(tournamentId) {
      let event = auditAfter(tournamentId, request.resource.data.lastTransitionId);
      return event.data.after.lock.uid == request.resource.data.lock.uid
        && event.data.after.lock.token == request.resource.data.lock.token
        && event.data.after.lock.recorderName == request.resource.data.lock.recorderName;
    }

    function isCurrentMatch(tournamentId, matchKey) {
      let currentAssignment = assignment(tournamentId, matchKey);
      let queue = queueFor(tournamentId, matchKey);
      return currentAssignment.data.matchType is string
        && queue.data.currentMatchKey == matchKey;
    }

    function ownsNewLock(tournamentId, matchKey) {
      let currentAssignment = assignment(tournamentId, matchKey);
      let court = get(/databases/$(database)/documents/tournaments/$(tournamentId)/courts/$(currentAssignment.data.courtId));
      return request.resource.data.lock.uid == request.auth.uid
        && request.resource.data.lock.token is string
        && request.resource.data.lock.recorderName is string
        && request.resource.data.lock.recorderName.size() > 0
        && court.data.get('recorderName', '').size() > 0
        && request.resource.data.lock.recorderName == court.data.get('recorderName', '');
    }

    function ownsExistingLock() {
      return resource.data.lock.uid == request.auth.uid
        && resource.data.lock.token is string
        && request.resource.data.lock.uid == resource.data.lock.uid
        && request.resource.data.lock.token == resource.data.lock.token
        && request.resource.data.lock.get('recorderName', '') == resource.data.lock.get('recorderName', '');
    }

    function assignmentAfter(tournamentId, matchKey, publicStatus) {
      let nextAssignment = getAfter(/databases/$(database)/documents/tournaments/$(tournamentId)/courtAssignments/$(matchKey));
      return nextAssignment.data.publicStatus == publicStatus
        && nextAssignment.data.lastTransitionId == request.resource.data.lastTransitionId;
    }

    function queueUnchanged(tournamentId, matchKey) {
      let queue = queueFor(tournamentId, matchKey);
      let nextQueue = getAfter(/databases/$(database)/documents/tournaments/$(tournamentId)/courtQueues/$(assignment(tournamentId, matchKey).data.courtId));
      return nextQueue.data.queueRevision == queue.data.queueRevision
        && nextQueue.data.currentMatchKey == matchKey;
    }

    function queueAdvanced(tournamentId, matchKey) {
      let queue = queueFor(tournamentId, matchKey);
      let nextQueue = getAfter(/databases/$(database)/documents/tournaments/$(tournamentId)/courtQueues/$(assignment(tournamentId, matchKey).data.courtId));
      return nextQueue.data.queueRevision == queue.data.queueRevision + 1
        && nextQueue.data.currentMatchKey != matchKey
        && nextQueue.data.lastTransitionId == request.resource.data.lastTransitionId;
    }

    function queueRecomputed(tournamentId, matchKey) {
      let queue = queueFor(tournamentId, matchKey);
      let nextQueue = getAfter(/databases/$(database)/documents/tournaments/$(tournamentId)/courtQueues/$(assignment(tournamentId, matchKey).data.courtId));
      return nextQueue.data.queueRevision == queue.data.queueRevision + 1
        && nextQueue.data.lastTransitionId == request.resource.data.lastTransitionId;
    }

    // The browser can only perform these bounded, match-local transitions.
    // All graph changes, official writes, review, and recovery are Admin SDK
    // operations in callable Functions and therefore bypass these Rules.
    function validClaim(tournamentId, matchKey) {
      return (resource.data.draftState == 'idle'
              || resource.data.draftState == 'rejected')
        && resource.data.lock == null
        && request.resource.data.draftState == 'editing'
        && ownsNewLock(tournamentId, matchKey)
        && auditHasNewLock(tournamentId)
        && request.resource.data.draftRevision == resource.data.draftRevision
        && request.resource.data.officialRevision == resource.data.officialRevision
        && assignmentAfter(tournamentId, matchKey, 'in_progress')
        && queueUnchanged(tournamentId, matchKey)
        && hasTransitionAudit(
          tournamentId, matchKey,
          resource.data.draftState == 'rejected' ? 'rejected_reclaim' : 'recorder_start',
          resource.data.draftState == 'rejected' ? 'rejected_reclaim' : 'recorder_start');
    }

    function validDraftSave(tournamentId, matchKey) {
      return resource.data.draftState == 'editing'
        && request.resource.data.draftState == 'editing'
        && ownsExistingLock()
        && auditHasExistingLock(tournamentId)
        && request.resource.data.draftRevision == resource.data.draftRevision + 1
        && request.resource.data.officialRevision == resource.data.officialRevision
        && hasTransitionAudit(tournamentId, matchKey, 'draft_save', 'draft_save');
    }

    function validCancel(tournamentId, matchKey) {
      return resource.data.draftState == 'editing'
        && request.resource.data.draftState in ['idle', 'rejected']
        && resource.data.lock.uid == request.auth.uid
        && resource.data.lock.token is string
        && auditHasExistingLock(tournamentId)
        && request.resource.data.lock == null
        && request.resource.data.draftRevision == resource.data.draftRevision
        && assignmentAfter(
          tournamentId, matchKey,
          request.resource.data.draftState == 'rejected' ? 'replay_required' : 'scheduled')
        && queueRecomputed(tournamentId, matchKey)
        && hasTransitionAudit(tournamentId, matchKey, 'recorder_cancel', 'recorder_cancel');
    }

    function validSubmit(tournamentId, matchKey) {
      return resource.data.draftState == 'editing'
        && request.resource.data.draftState == 'submitted'
        && resource.data.lock.uid == request.auth.uid
        && resource.data.lock.token is string
        && auditHasExistingLock(tournamentId)
        && request.resource.data.lock == null
        && request.resource.data.submissionVersion == resource.data.submissionVersion + 1
        && request.resource.data.draftRevision == resource.data.draftRevision
        && assignmentAfter(tournamentId, matchKey, 'under_review')
        && queueAdvanced(tournamentId, matchKey)
        && hasTransitionAudit(tournamentId, matchKey, 'submission_complete', 'submission_complete');
    }

    function assignmentMatchesWorkflow(tournamentId, matchKey) {
      let workflow = getAfter(/databases/$(database)/documents/tournaments/$(tournamentId)/scoreWorkflows/$(matchKey));
      return (workflow.data.draftState == 'editing'
              && request.resource.data.publicStatus == 'in_progress')
        || (workflow.data.draftState == 'idle'
              && request.resource.data.publicStatus == 'scheduled')
        || (workflow.data.draftState == 'rejected'
              && request.resource.data.publicStatus == 'replay_required')
        || (workflow.data.draftState == 'submitted'
              && request.resource.data.publicStatus == 'under_review');
    }

    function queueMatchesWorkflow(tournamentId, courtId) {
      let priorQueue = get(/databases/$(database)/documents/tournaments/$(tournamentId)/courtQueues/$(courtId));
      let currentWorkflow = getAfter(/databases/$(database)/documents/tournaments/$(tournamentId)/scoreWorkflows/$(priorQueue.data.currentMatchKey));
      return currentWorkflow.data.draftState in ['idle', 'rejected', 'submitted']
        && request.resource.data.queueRevision == priorQueue.data.queueRevision + 1;
    }

    match /tournaments/{tournamentId} {
      allow read: if isMain(tournamentId);
      allow create, delete: if false;
      allow update: if isMain(tournamentId) && isAdmin() && isNotMaintained(tournamentId);

      match /groups/{groupId} {
        allow read: if isMain(tournamentId);
        allow write: if isMain(tournamentId) && isAdmin() && isNotMaintained(tournamentId);
      }
      match /teams/{teamId} {
        allow read: if isMain(tournamentId);
        allow write: if isMain(tournamentId) && isAdmin() && isNotMaintained(tournamentId);
      }
      match /prelimMatches/{matchId} {
        allow read: if isMain(tournamentId);
        allow create: if isMain(tournamentId)
          && isAdmin() && isNotMaintained(tournamentId)
          && request.resource.data.sets.size() == 0
          && request.resource.data.status == 'pending'
          && request.resource.data.result == null;
        allow delete: if isMain(tournamentId) && isAdmin() && isNotMaintained(tournamentId);
        allow update: if isMain(tournamentId)
          && isAdmin() && isNotMaintained(tournamentId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'round'
          ]);
      }
      match /divisions/{divisionId}/finalMatches/{matchId} {
        allow read: if isMain(tournamentId);
        allow write: if false;
      }
      match /courts/{courtId} {
        allow read: if isMain(tournamentId)
          && (isAdmin() || hasCurrentRecorderGrant(tournamentId));
        allow write: if false;
      }
      match /courtAssignments/{matchKey} {
        allow get: if isMain(tournamentId)
          && (isAdmin() || hasCurrentRecorderGrant(tournamentId));
        allow list: if isMain(tournamentId) && isAdmin();
        allow update: if isMain(tournamentId)
          && hasCurrentRecorderGrant(tournamentId)
          && isCurrentMatch(tournamentId, matchKey)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['publicStatus', 'attemptCount', 'lastTransitionId'])
          && request.resource.data.lastTransitionId is string
          && assignmentMatchesWorkflow(tournamentId, matchKey)
          && getAfter(/databases/$(database)/documents/tournaments/$(tournamentId)/scoreWorkflows/$(matchKey)).data.lastTransitionId
              == request.resource.data.lastTransitionId;
        allow create, delete: if false;
      }
      match /courtQueues/{courtId} {
        allow get: if isMain(tournamentId)
          && (isAdmin() || hasCurrentRecorderGrant(tournamentId));
        allow list: if isMain(tournamentId) && isAdmin();
        allow create, update, delete: if false;
      }

      match /recorderAccessChallenge/current {
        allow read: if isMain(tournamentId);
        allow write: if false;
      }
      match /recorderGrants/{uid} {
        allow get: if isMain(tournamentId) && request.auth != null && request.auth.uid == uid;
        allow list: if false;
        allow create, update, delete: if false;
      }
      match /scoreWorkflows/{matchKey} {
        // A current-grant recorder can fetch the single current workflow to
        // claim it, then only its owned workflow. Queries remain closed.
        allow get: if isMain(tournamentId)
          && (isAdmin()
            || (hasCurrentRecorderGrant(tournamentId)
              && resource.data.lock != null
              && resource.data.lock.uid == request.auth.uid));
        allow get: if isMain(tournamentId)
          && hasCurrentRecorderGrant(tournamentId)
          && isCurrentMatch(tournamentId, matchKey)
          && resource.data.lock == null
          && resource.data.draftState in ['idle', 'rejected'];
        allow list: if isMain(tournamentId) && isAdmin();
        allow update: if isMain(tournamentId)
          && hasCurrentRecorderGrant(tournamentId)
          && isCurrentMatch(tournamentId, matchKey)
          && validClaim(tournamentId, matchKey)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'draftState', 'resumeDraftState', 'lock', 'lastTransitionId'
          ]);
        allow update: if isMain(tournamentId)
          && hasCurrentRecorderGrant(tournamentId)
          && validDraftSave(tournamentId, matchKey)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'draft', 'draftRevision', 'lastTransitionId'
          ]);
        allow create, delete: if false;
      }
      match /auditEvents/{transitionId} {
        allow read: if isMain(tournamentId) && isAdmin();
        allow update, delete: if false;
        allow create: if isMain(tournamentId)
          && request.auth != null
          && isNotMaintained(tournamentId)
          && request.resource.data.transitionId == transitionId
          && request.resource.data.actor.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.matchKey is string
          && getAfter(/databases/$(database)/documents/tournaments/$(tournamentId)/scoreWorkflows/$(request.resource.data.matchKey)).data.lastTransitionId
              == transitionId;
      }

      // These collections are function-private, including for seeded admins.
      match /admins/{uid} {
        allow get: if isMain(tournamentId) && request.auth != null && request.auth.uid == uid;
        allow list, write: if false;
      }
      match /recorderAccess/{document=**} { allow read, write: if false; }
      match /migrationManifests/{manifestId} { allow read, write: if false; }
      match /officialRevisions/{revisionId} {
        allow read: if isMain(tournamentId) && isAdmin();
        allow write: if false;
      }
      match /restoreManifests/{document=**} {
        allow read: if isMain(tournamentId) && isAdmin();
        allow write: if false;
      }
      match /{document=**} { allow read, write: if false; }
    }
  }
}
