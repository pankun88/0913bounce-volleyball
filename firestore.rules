rules_version = '2';

// 관리자 페이지(admin.html)는 Firebase Authentication 이메일/비밀번호 로그인으로
// 보호됩니다. 로그인한 사용자만 쓰기(점수 입력, 팀/조 관리 등)가 가능합니다.
// 대시보드는 누구나 볼 수 있어야 하므로 읽기는 계속 열어둡니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if request.auth != null;

      // 남자부/여자부 본선 대진표처럼 여러 단계 아래에 있는 문서까지 같은 정책을 적용한다.
      match /{document=**} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
  }
}
